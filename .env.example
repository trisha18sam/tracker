# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sih:sih_password@localhost:5432/eta_forecast
DATABASE_SYNC_URL=postgresql://sih:sih_password@localhost:5432/eta_forecast

# ─── Redis (optional, for future queue) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── FastAPI ─────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-real-secret-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_V1_PREFIX=/api/v1
DEBUG=true

# ─── ML Model ────────────────────────────────────────────────
MODEL_PATH=../ml/artifacts/xgb_model.joblib
SCALER_PATH=../ml/artifacts/scaler.joblib
FEATURE_LIST_PATH=../ml/artifacts/feature_list.json
EVAL_RESULTS_PATH=../ml/artifacts/evaluation_results.json

# ─── Simulation Engine ────────────────────────────────────────
# Speed factor: 60 means 1 simulated minute passes per 1 real second
SIM_SPEED_FACTOR=60
SIM_TELEMETRY_INTERVAL_SEC=2
# Base URL of the backend API the simulation posts to
BACKEND_API_URL=http://localhost:8000
