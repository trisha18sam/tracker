# ─── Database ───────────────────────────────────────────────
# Default SQLite database for instant zero-configuration local execution
DATABASE_URL=sqlite+aiosqlite:///tracker.db
DATABASE_SYNC_URL=sqlite:///tracker.db

# ─── FastAPI ─────────────────────────────────────────────────
SECRET_KEY=sih2026-eta-secret-key-dynamic-forecast
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
API_V1_PREFIX=/api/v1
DEBUG=true

# ─── ML Model ────────────────────────────────────────────────
MODEL_PATH=../ml/artifacts/xgb_model.joblib
SCALER_PATH=../ml/artifacts/scaler.joblib
FEATURE_LIST_PATH=../ml/artifacts/feature_list.json
EVAL_RESULTS_PATH=../ml/artifacts/evaluation_results.json

# ─── Simulation Engine ────────────────────────────────────────
SIM_SPEED_FACTOR=60
SIM_TELEMETRY_INTERVAL_SEC=2
BACKEND_API_URL=http://localhost:8000
